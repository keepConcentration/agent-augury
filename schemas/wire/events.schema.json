{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-augury.dev/schemas/wire/events.schema.json",
  "title": "AuguryWireEvents",
  "description": "Server → surfaces (dir=event).",
  "oneOf": [
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "session.started" },
        "agents": { "type": "array", "items": { "type": "string" } },
        "meta": { "type": "object" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "session.phase" },
        "phase": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "session.gate" },
        "phase": { "type": "string" },
        "thread_id": { "type": ["string", "null"] },
        "thread_name": { "type": "string" },
        "approvals": { "type": "array", "items": { "type": "string" } },
        "pending": { "type": "array", "items": { "type": "string" } },
        "open": { "type": "boolean" },
        "has_proposal": { "type": "boolean" },
        "require_proposal": { "type": "boolean" },
        "human_pending": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "session.human_approval_pending" },
        "phase": { "type": "string" },
        "thread_id": { "type": "string" },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "session.checkpoint" },
        "session_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "session.resumed" },
        "session_id": { "type": "string" },
        "phase": { "type": "string" },
        "agents": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "session.resume_failed" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "agent_id"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "agent.step" },
        "agent_id": { "type": "string" },
        "result": { "type": "object" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "tool" },
        "agent_id": { "type": "string" },
        "tool": { "type": "string" },
        "args": { "type": "object" },
        "result": {}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "question"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "human.question" },
        "agent_id": { "type": "string" },
        "thread_id": { "type": "string" },
        "question": { "type": "string" },
        "question_id": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "thread.created" },
        "thread_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "message" },
        "thread_id": { "type": "string" },
        "author": { "type": "string" },
        "content": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "text"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "log" },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "session.ended" },
        "steps": { "type": "integer" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "message"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "error" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "read_resource" },
        "agent_id": { "type": "string" },
        "threads": { "type": "integer" },
        "messages": { "type": "integer" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "approval_id", "agent_id", "tool"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "approval.request" },
        "approval_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "tool": { "type": "string" },
        "args_preview": { "type": "object" },
        "ttl_seconds": { "type": "number" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "approval_id", "decision"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "approval.resolved" },
        "approval_id": { "type": "string" },
        "decision": {
          "type": "string",
          "enum": ["granted", "denied", "expired"]
        },
        "reason": { "type": "string" },
        "agent_id": { "type": "string" },
        "tool": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "approval_id"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "approval.granted" },
        "approval_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "tool": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "approval_id"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "approval.expired" },
        "approval_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "tool": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["dir", "type", "reason"],
      "properties": {
        "dir": { "const": "event" },
        "type": { "const": "tool.denied" },
        "reason": { "type": "string" },
        "approval_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "tool": { "type": "string" }
      },
      "additionalProperties": true
    }
  ]
}
