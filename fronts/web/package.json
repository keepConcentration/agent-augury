{
  "name": "@agent-augury/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web Surface (BFF + SPA) for agent-augury",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/bff/main.ts",
    "build": "vite build",
    "test": "tsx --test src/bff/*.test.ts src/ui/*.test.ts src/ui/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.4.5"
  }
}
