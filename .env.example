# agent-augury 환경변수 예시 — 이 파일을 .env로 복사하고 값을 채우세요.
# .env는 gitignore 대상이므로 절대 커밋되지 않습니다.
# YAML 설정에는 값 대신 "환경변수 이름"만 적습니다 (보안 원칙).

# ── OpenAI-compatible 백엔드 (backend.type: openai) ────────────────────────
# OPENAI_API_KEY=sk-...

# ── Nous Portal 백엔드 (backend.type: nous) ────────────────────────────────
# NOUS_API_KEY=nk-...

# ── Nous Portal OAuth (backend.type: nous_oauth) ───────────────────────────
# 키 불필요 — 디바이스 코드 플로우로 브라우저 인증, ~/.agent-augury/tokens.json 저장

# ── Discord 웹훅 미러 (mirror.type: discord_webhook) ───────────────────────
# AUGURY_MIRROR_URL=https://discord.com/api/webhooks/...

# ── Discord 봇 N개 (bots: 섹션, token_env 참조) ────────────────────────────
# 각 봇은 agent_id에 바인딩됩니다. 채널 ID도 여기로 빼는 것을 권장
# (examples/multi_bot_demo.yaml의 하드코딩 채널 ID를 대체).
# BOT_TOKEN_AGENT_1=
# BOT_TOKEN_AGENT_2=
# BOT_TOKEN_AGENT_3=
# BOT_TOKEN_AGENT_4=
# BOT_CHANNEL_ID_AGENT_1=
# BOT_CHANNEL_ID_AGENT_2=
# BOT_CHANNEL_ID_AGENT_3=
# BOT_CHANNEL_ID_AGENT_4=

# ── 테스트 (opt-in, 비용 발생) ─────────────────────────────────────────────
# AUGURY_RUN_OPENAI_TESTS=1
# OPENAI_API_KEY=sk-...
